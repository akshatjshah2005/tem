{
  "schemaVersion": 1,
  "name": "Gujarati Shubh Vivah",
  "slug": "wedding-gujarati-shubh-vivah",
  "description": "A festive Gujarati wedding invitation inspired by warm ceremonial colours and joyful family traditions.",
  "version": "1.0.0",
  "isPremium": false,
  "features": {
    "multipleEvents": true,
    "gallery": true,
    "guestPersonalization": true,
    "guestEventFiltering": true,
    "map": true,
    "countdown": true,
    "rsvp": true,
    "music": false
  },
  "variables": {
    "bride_name": {
      "type": "text",
      "required": true,
      "default": ""
    },
    "groom_name": {
      "type": "text",
      "required": true,
      "default": ""
    },
    "family_name": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "guest_name": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "event_name": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "event_date": {
      "type": "date",
      "required": false,
      "default": ""
    },
    "event_time": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "venue_name": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "venue_address": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "invitation_message": {
      "type": "textarea",
      "required": false,
      "default": ""
    },
    "hero_eyebrow": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "closing_line": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "hashtag": {
      "type": "text",
      "required": false,
      "default": ""
    },
    "cover_image": {
      "type": "image",
      "required": false,
      "default": ""
    },
    "rsvp_note": {
      "type": "textarea",
      "required": false,
      "default": ""
    }
  },
  "editableFields": {
    "bride_name": {
      "type": "text",
      "label": "Bride Name",
      "required": true,
      "editable": true,
      "placeholder": "e.g. Priya",
      "maxLength": 60
    },
    "groom_name": {
      "type": "text",
      "label": "Groom Name",
      "required": true,
      "editable": true,
      "placeholder": "e.g. Akshat",
      "maxLength": 60
    },
    "family_name": {
      "type": "text",
      "label": "Family Name",
      "required": false,
      "editable": true,
      "placeholder": "e.g. Shah Family",
      "maxLength": 80
    },
    "hero_eyebrow": {
      "type": "text",
      "label": "Hero Eyebrow Text",
      "required": false,
      "editable": true,
      "placeholder": "You are invited",
      "maxLength": 80
    },
    "invitation_message": {
      "type": "textarea",
      "label": "Invitation Message",
      "required": false,
      "editable": true,
      "rows": 4,
      "maxLength": 600
    },
    "closing_line": {
      "type": "text",
      "label": "Closing Line",
      "required": false,
      "editable": true,
      "placeholder": "With love",
      "maxLength": 60
    },
    "hashtag": {
      "type": "text",
      "label": "Wedding Hashtag",
      "required": false,
      "editable": true,
      "placeholder": "#AkshatWedsPriya",
      "maxLength": 60
    },
    "rsvp_note": {
      "type": "textarea",
      "label": "RSVP Note",
      "required": false,
      "editable": true,
      "rows": 2,
      "maxLength": 240
    },
    "cover_image": {
      "type": "url",
      "label": "Cover Image URL",
      "required": false,
      "editable": true,
      "placeholder": "https://..."
    }
  },
  "config": {
    "schemaVersion": 1,
    "impl": "wedding",
    "variant": "gujarati",
    "design": {
      "palette": {
        "paper": "#fff6e7",
        "surface": "#fffdf8",
        "ink": "#743b25",
        "muted": "#956e58",
        "gold": "#c06b34",
        "goldDeep": "#8f4726",
        "goldSoft": "#f0d1a8",
        "heroText": "#fff9ee",
        "heroOverlay": "linear-gradient(180deg, rgba(98,42,22,0.20) 0%, rgba(98,42,22,0.80) 100%)"
      },
      "typography": {
        "script": "'Cormorant Garamond', Georgia, serif",
        "serif": "'Cormorant Garamond', Georgia, serif",
        "sans": "var(--font-inter), system-ui, -apple-system, sans-serif"
      },
      "copy": {
        "heroEyebrow": "Shubh Vivah",
        "heroInvitationLine": "With blessings, joy and family",
        "guestLead": "You are cordially invited to the wedding of",
        "messageHeading": "Gujarati Shubh Vivah",
        "invitationMessage": "We would be honoured by your presence as we exchange vows and begin our life together.",
        "countdownLabel": "Counting down to our day",
        "eventsHeading": "Schedule",
        "eventsLead": "The details of our celebration",
        "galleryHeading": "Gallery",
        "galleryLead": "",
        "rsvpHeading": "RSVP",
        "rsvpNote": "Please let us know if you can join us.",
        "rsvpAcceptLabel": "Joyfully Accept",
        "rsvpDeclineLabel": "Regretfully Decline",
        "closingLine": "With love",
        "shareHeading": "Share this invitation",
        "noticeText": "This is a general view of the invitation. A personalized version may have been prepared for you.",
        "noEventsText": "Event details will be announced shortly.",
        "footerText": "Created with UPTEMP"
      }
    },
    "sections": [
      {
        "id": "hero",
        "type": "hero",
        "enabled": true,
        "eyebrow": "{{heroEyebrow}}",
        "showDate": true,
        "showScrollCue": true
      },
      {
        "id": "guest",
        "type": "guest_greeting",
        "enabled": true,
        "lead": "{{guestLead}}"
      },
      {
        "id": "message",
        "type": "message",
        "enabled": true,
        "heading": "{{messageHeading}}",
        "text": "{{invitationMessage}}"
      },
      {
        "id": "countdown",
        "type": "countdown",
        "enabled": true,
        "label": "{{countdownLabel}}"
      },
      {
        "id": "events",
        "type": "event_list",
        "enabled": true,
        "heading": "{{eventsHeading}}",
        "lead": "{{eventsLead}}",
        "layout": "list",
        "showMap": true,
        "showDressCode": true,
        "showDescription": false
      },
      {
        "id": "gallery",
        "type": "gallery",
        "enabled": false,
        "heading": "{{galleryHeading}}",
        "lead": "{{galleryLead}}",
        "columns": 3,
        "maxImages": 12
      },
      {
        "id": "notice",
        "type": "personalization_notice",
        "enabled": true,
        "text": "{{noticeText}}"
      },
      {
        "id": "rsvp",
        "type": "rsvp",
        "enabled": true,
        "heading": "{{rsvpHeading}}",
        "note": "{{rsvpNote}}"
      },
      {
        "id": "closing",
        "type": "closing",
        "enabled": true,
        "lead": "{{closingLine}}"
      }
    ]
  }
}
