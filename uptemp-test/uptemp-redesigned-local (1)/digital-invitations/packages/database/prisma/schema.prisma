// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  mobile            String?   @unique
  passwordHash      String    @map("password_hash")
  avatarUrl         String?   @map("avatar_url")
  role              UserRole  @default(CUSTOMER)
  isActive          Boolean   @default(true) @map("is_active")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  mobileVerifiedAt  DateTime? @map("mobile_verified_at")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  invitations       Invitation[]
  bulkRequests      BulkRequest[]
  media             Media[]

  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

// Category model
model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  description   String?
  icon          String?
  displayOrder  Int        @default(0) @map("display_order")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  templates     Template[]

  @@map("categories")
}

// Template model
model Template {
  id              String   @id @default(uuid())
  categoryId      String   @map("category_id")
  name            String
  slug            String   @unique
  description     String?
  thumbnailUrl    String?  @map("thumbnail_url")
  previewUrl      String?  @map("preview_url")
  version         String   @default("1.0.0")
  config          Json     @default("{}")
  features        Json     @default("{}")
  editableFields  Json     @map("editable_fields") @default("{}")
  variables       Json     @default("{}")
  status          TemplateStatus @default(DRAFT)
  isPremium       Boolean  @default(false) @map("is_premium")
  popularity      Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category        Category @relation(fields: [categoryId], references: [id])
  versions        TemplateVersion[]
  invitations     Invitation[]

  @@map("templates")
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Template Version model
model TemplateVersion {
  id              String   @id @default(uuid())
  templateId      String   @map("template_id")
  version         String
  config          Json
  features        Json
  editableFields  Json     @map("editable_fields")
  variables       Json
  changelog       String?
  createdAt       DateTime @default(now()) @map("created_at")

  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@map("template_versions")
}

// Invitation model
model Invitation {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  templateId            String?  @map("template_id")
  name                  String
  slug                  String
  description           String?
  content               Json     @default("{}")
  status                InvitationStatus @default(DRAFT)
  isPersonalized        Boolean  @default(false) @map("is_personalized")
  personalizationEnabled Boolean @default(false) @map("personalization_enabled")
  coverImageUrl         String?  @map("cover_image_url")
  whatsappMessageTemplate String? @map("whatsapp_message_template")
  guestCount            Int      @default(0) @map("guest_count")
  views                 Int      @default(0)
  expiresAt             DateTime? @map("expires_at")
  publishedAt           DateTime? @map("published_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template              Template? @relation(fields: [templateId], references: [id])
  events                Event[]
  guests                Guest[]
  media                 Media[]
  whatsappMessage       WhatsAppMessage?
  bulkRequests          BulkRequest[]
  analytics             Analytics[]
  rsvps                 Rsvp[]

  @@unique([userId, slug])
  @@map("invitations")
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

// Event model
model Event {
  id              String   @id @default(uuid())
  invitationId    String   @map("invitation_id")
  name            String
  description     String?
  date            DateTime @db.Date
  startTime       DateTime? @map("start_time") @db.Time()
  endTime         DateTime? @map("end_time") @db.Time()
  venueName       String?  @map("venue_name")
  venueAddress    String?  @map("venue_address")
  mapUrl          String?  @map("map_url")
  mapLat          Decimal? @map("map_lat") @db.Decimal(10, 8)
  mapLng          Decimal? @map("map_lng") @db.Decimal(11, 8)
  dressCode       String?  @map("dress_code")
  imageUrl        String?  @map("image_url")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestEvents     GuestEvent[]

  @@map("events")
}

// Guest model
model Guest {
  id                String    @id @default(uuid())
  invitationId      String    @map("invitation_id")
  name              String
  mobile            String?
  email             String?
  groupName         String?   @map("group_name")
  groupId           String?   @map("group_id")
  personalToken     String    @unique @map("personal_token")
  personalizedLink  String?   @map("personalized_link")
  status            GuestStatus @default(LINK_GENERATED)
  customMessage     String?   @map("custom_message")
  openedAt          DateTime? @map("opened_at")
  lastAccessedAt    DateTime? @map("last_accessed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  invitation        Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestEvents       GuestEvent[]
  rsvp              Rsvp?

  @@map("guests")
}

enum GuestStatus {
  LINK_GENERATED
  SENT
  OPENED
  RSVP_RECEIVED
  ATTENDING
  NOT_ATTENDING
}

// Guest Event junction model
model GuestEvent {
  id          String   @id @default(uuid())
  guestId     String   @map("guest_id")
  eventId     String   @map("event_id")
  createdAt   DateTime @default(now()) @map("created_at")

  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([guestId, eventId])
  @@map("guest_events")
}

// RSVP model
model Rsvp {
  id            String    @id @default(uuid())
  guestId       String    @unique @map("guest_id")
  invitationId  String    @map("invitation_id")
  response      RsvpResponse @default(PENDING)
  guestsCount   Int       @default(1) @map("guests_count")
  dietary       String?
  message       String?
  respondedAt   DateTime? @map("responded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  guest         Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}

enum RsvpResponse {
  PENDING
  ACCEPT
  DECLINE
}

// Media model
model Media {
  id              String   @id @default(uuid())
  invitationId    String   @map("invitation_id")
  uploadedBy      String?  @map("uploaded_by")
  originalUrl     String   @map("original_url")
  optimizedUrl    String?  @map("optimized_url")
  thumbnailUrl    String?  @map("thumbnail_url")
  fileName        String?  @map("file_name")
  fileSize        Int?     @map("file_size")
  mimeType        String?  @map("mime_type")
  width           Int?
  height          Int?
  galleryOrder    Int?     @map("gallery_order")
  isCover         Boolean  @default(false) @map("is_cover")
  createdAt       DateTime @default(now()) @map("created_at")

  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  uploader        User?    @relation(fields: [uploadedBy], references: [id])

  @@map("media")
}

// WhatsApp Message model
model WhatsAppMessage {
  id              String   @id @default(uuid())
  invitationId    String   @unique @map("invitation_id")
  templateText    String   @map("template_text")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_messages")
}

// Bulk Request model
model BulkRequest {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  invitationId    String   @map("invitation_id")
  recipientCount  Int      @map("recipient_count")
  message         String?
  sendDate        DateTime? @map("send_date")
  status          BulkRequestStatus @default(PENDING)
  adminNotes      String?  @map("admin_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id])
  invitation      Invitation @relation(fields: [invitationId], references: [id])

  @@map("bulk_requests")
}

enum BulkRequestStatus {
  PENDING
  CONTACTING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Analytics model
model Analytics {
  id              String   @id @default(uuid())
  invitationId    String   @map("invitation_id")
  guestId         String?  @map("guest_id")
  eventType       String   @map("event_type")
  deviceType      String?  @map("device_type")
  browser         String?
  os              String?
  country         String?
  city            String?
  referrer        String?
  duration        Int?
  createdAt       DateTime @default(now()) @map("created_at")

  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([eventType])
  @@index([createdAt])
  @@map("analytics")
}
